# Production Environment Variables for QueueBee Frontend
# Copy this file to .env and update with your actual values

# Backend API URL (Update after deploying backend)
REACT_APP_BACKEND_URL=https://queuebee-backend-xyz.a.run.app

# App Configuration
REACT_APP_APP_NAME=QueueBee
REACT_APP_ENVIRONMENT=production

# Optional: Analytics (Google Analytics, etc.)
# REACT_APP_GA_TRACKING_ID=GA_MEASUREMENT_ID

# Optional: Error Tracking (Sentry, etc.)
# REACT_APP_SENTRY_DSN=your-sentry-dsn